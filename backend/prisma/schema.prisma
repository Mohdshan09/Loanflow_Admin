// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
}

enum SalaryType {
  DAT
  CASH
  CHEQUE
}

enum UserStatus {
  ACTIVE
  REJECTED
}

enum Role {
  ADMIN
  VIEWER
}

enum EvaluationTrigger {
  USER_CREATED
  USER_UPDATED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  MANUAL_SIMULATION
}

model Admin {
  id           String @id @default(uuid()) @db.Uuid
  fullName     String
  email        String @unique
  passwordHash String
  role         Role   @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  fullName       String
  dateOfBirth    DateTime
  creditScore    Int
  employmentType EmploymentType
  salaryType     SalaryType
  salary         Decimal        @db.Decimal(12, 2)
  status         UserStatus     @default(REJECTED)

  eligibleProducts UserProduct[]
  evaluations      EligibilityEvaluation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model EligibilityEvaluation {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  trigger   EvaluationTrigger
  createdAt DateTime          @default(now())

  user    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  results EligibilityEvaluationResult[]

  @@index([userId, createdAt])
}

model EligibilityEvaluationResult {
  id           String   @id @default(uuid()) @db.Uuid
  evaluationId String   @db.Uuid
  productId    String   @db.Uuid
  productName  String
  eligible     Boolean
  reasons      String[]
  decisionNote String

  evaluation EligibilityEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}

model Product {
  id   String @id @default(uuid()) @db.Uuid
  name String

  minAge                 Int
  maxAge                 Int
  minCreditScore         Int
  allowedEmploymentTypes EmploymentType[]
  allowedSalaryTypes     SalaryType[]
  minSalary              Decimal          @db.Decimal(12, 2)

  eligibleUsers UserProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProduct {
  userId    String @db.Uuid
  productId String @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}
